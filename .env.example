# Leave unset to keep the standalone local demo. Do not commit a real .env file.
# Browser configuration: publishable/anon key only, NEVER service_role or sb_secret_.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_API_BASE_URL=http://localhost:3001

# Backend uses the same public key plus each user's verified JWT, preserving RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
