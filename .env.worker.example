# Load only in the private Python worker, never in Vite or committed .env files.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy JWT service-role keys are supported as SUPABASE_SERVICE_ROLE_KEY instead.
# rembg downloads its pretrained model here on first worker startup.
U2NET_HOME=./work/model-cache
NUMBA_CACHE_DIR=./work/numba-cache
XDG_CACHE_HOME=./work/runtime-cache
OMP_NUM_THREADS=2
